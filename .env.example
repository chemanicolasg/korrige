# ── Frontend (Vite). En Netlify: Site configuration → Environment variables ──
# URL y clave pública (anon) del proyecto de Supabase: Project Settings → API.
# Si se dejan vacías, la app arranca en MODO DEMO (datos solo en el navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: URL del formulario de ventas. Por defecto <VITE_SUPABASE_URL>/functions/v1/sales-lead
# VITE_SALES_ENDPOINT=

# ── Solo para scripts locales (NUNCA en Netlify ni en el frontend) ──
# npm run seed:demo
SUPABASE_SERVICE_ROLE_KEY=
DEMO_EMAIL=demo@korrige.es
DEMO_PASSWORD=

# ── Secretos de las Edge Functions (se configuran con `supabase secrets set`, no aquí) ──
# RESEND_API_KEY=re_...
# SALES_EMAIL=ventas@korrige.es
# SALES_FROM=Korrige <no-reply@korrige.es>
# ALLOWED_ORIGINS=https://korrige.es,https://www.korrige.es
# LEAD_SALT=una-cadena-aleatoria
# CRON_SECRET=otra-cadena-aleatoria   (retention-purge)
# STRIPE_SECRET_KEY=sk_live_...      (create-checkout, billing-portal, stripe-webhook)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS_MONTH=price_...
# STRIPE_PRICE_PLUS_YEAR=price_...
